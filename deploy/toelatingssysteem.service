[Unit]
Description=Toelatingssysteem veiligheidssprong
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/toelatingssysteem/backend
ExecStart=/opt/toelatingssysteem/backend/.venv/bin/uvicorn asgi:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
User=toelating

[Install]
WantedBy=multi-user.target
