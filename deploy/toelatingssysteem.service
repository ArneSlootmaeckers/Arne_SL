[Unit]
Description=Toelatingssysteem veiligheidssprong
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/toelatingssysteem/backend
ExecStart=/opt/toelatingssysteem/backend/.venv/bin/python3 run.py
Restart=on-failure
# Na een update stopt run.py met code 3 (niet 0), zodat systemd hem herstart.
RestartSec=3
User=toelating

[Install]
WantedBy=multi-user.target
